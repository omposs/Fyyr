# Copy to .env.local (not committed). Only VITE_* values reach the browser: never put API keys or other secrets here.

# Backend base URL, no trailing slash. The backend's default CORS list already allows http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000

# How you log in. "backend" (default): real login against the API, no 6-digit code.
# "demo": the original simulated login (any password, any 6-digit code), no backend needed.
# VITE_AUTH_MODE=backend

# What the screens show first. "demo" (default): the full demo content. "live": data from the backend.
# Members can switch at any time with the Demo data / Live data button in the page header.
# Logging in and content are independent: you can log in for real and still show the demo content.
# VITE_CONTENT_MODE=demo
